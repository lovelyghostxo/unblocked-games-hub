    "fallbackHtml": "<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{margin:0;background:#70c5ce;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#fff}canvas{border:4px solid #fff;border-radius:8px;box-shadow:0 10px 20px rgba(0,0,0,0.2)}</style></head><body><h2 style='margin:5px;'>FLAPPY QUEST</h2><canvas id='c' width='320' height='480'></canvas><p>Click or Press Space to Jump</p><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d');let bird={x:50,y:150,v:0,g:0.4,j:-7},pipes=[],score=0,frame=0,over=false;function draw(){if(over){ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(0,0,320,480);ctx.fillStyle='#fff';ctx.font='24px sans-serif';ctx.fillText('Game Over!',90,220);ctx.fillText('Score: '+score,110,260);return;}bird.v+=bird.g;bird.y+=bird.v;if(frame%90===0){pipes.push({x:320,top:Math.floor(Math.random()*180)+40,gap:110});}ctx.fillStyle='#70c5ce';ctx.fillRect(0,0,320,480);ctx.fillStyle='#f1c40f';ctx.beginPath();ctx.arc(bird.x,bird.y,12,0,Math.PI*2);ctx.fill();for(let i=pipes.length-1;i>=0;i--){pipes[i].x-=2;ctx.fillStyle='#2ecc71';ctx.fillRect(pipes[i].x,0,45,pipes[i].top);ctx.fillRect(pipes[i].x,pipes[i].top+pipes[i].gap,45,480);if(bird.x+12>pipes[i].x && bird.x-12<pipes[i].x+45 && (bird.y-12<pipes[i].top || bird.y+12>pipes[i].top+pipes[i].gap)){over=true;}if(pipes[i].x===bird.x)score++;if(pipes[i].x<-50)pipes.splice(i,1);}if(bird.y>480||bird.y<0)over=true;ctx.fillStyle='#fff';ctx.font='28px sans-serif';ctx.fillText(score,150,50);frame++;requestAnimationFrame(draw);}function jump(){if(over){bird={x:50,y:150,v:0,g:0.4,j:-7};pipes=[];score=0;frame=0;over=false;requestAnimationFrame(draw);return;}bird.v=bird.j;}window.addEventListener('keydown',e=>{if(e.code==='Space')jump();});canvas.addEventListener('click',jump);draw();</script></body></html>"
