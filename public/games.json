    "tags": ["Action", "Arcade", "Hexagon", "Fast"],
    "author": "Hextris Team",
    "fallbackHtml": "<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{margin:0;background:#0d1117;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh}canvas{background:#161b22;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,0.5)}h2{margin-bottom:10px}</style></head><body><h2>Hextris Arc</h2><canvas id='c' width='400' height='400'></canvas><p>Press Left/Right Arrow Keys to Rotate Hexagon</p><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d');let angle=0,score=0;function draw(){ctx.clearRect(0,0,400,400);ctx.save();ctx.translate(200,200);ctx.rotate(angle);ctx.beginPath();for(let i=0;i<6;i++){let a=i*Math.PI/3;ctx.lineTo(60*Math.cos(a),60*Math.sin(a));}ctx.closePath();ctx.strokeStyle='#58a6ff';ctx.lineWidth=4;ctx.stroke();ctx.restore();ctx.fillStyle='#8b949e';ctx.font='16px sans-serif';ctx.fillText('Score: '+score,10,30);requestAnimationFrame(draw);}window.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')angle-=0.2;if(e.key==='ArrowRight')angle+=0.2;score+=5;});draw();</script></body></html>"
