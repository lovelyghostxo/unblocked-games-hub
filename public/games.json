    "fallbackHtml": "<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{margin:0;background:#1e1e2e;color:#cdd6f4;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh}#board{display:grid;grid-template-columns:repeat(8,36px);gap:4px;background:#313244;padding:8px;border-radius:8px}.cell{width:36px;height:36px;background:#45475a;display:flex;align-items:center;justify-content:center;font-weight:bold;cursor:pointer;user-select:none;border-radius:4px}.cell.open{background:#181825}</style></head><body><h2>MINESWEEPER</h2><p>Left Click: Open | Right Click: Flag</p><div id='board'></div><script>const b=document.getElementById('board');let grid=[],mines=10;for(let r=0;r<8;r++){for(let c=0;c<8;c++){let d=document.createElement('div');d.className='cell';d.dataset.r=r;d.dataset.c=c;d.onclick=()=>click(d,r,c);d.oncontextmenu=(e)=>{e.preventDefault();d.innerText=d.innerText==='🚩'?'':'🚩';};b.appendChild(d);grid.push({r,c,mine:Math.random()<0.18,open:false,el:d});}}function click(el,r,c){let cell=grid.find(g=>g.r===r&&g.c===c);if(!cell||cell.open)return;cell.open=true;el.classList.add('open');if(cell.mine){el.innerText='💣';alert('BOOM! Game Over');location.reload();}else{let count=0;grid.forEach(g=>{if(Math.abs(g.r-r)<=1&&Math.abs(g.c-c)<=1&&g.mine)count++;});el.innerText=count>0?count:'';}}</script></body></html>"
