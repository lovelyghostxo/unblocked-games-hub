    "fallbackHtml": "<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>2048</title><style>body{margin:0;background:#faf8ef;font-family:'Clear Sans','Helvetica Neue',Arial,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;color:#776e65}h1{margin:0;font-size:48px;font-weight:bold;color:#776e65}p{margin:5px 0 15px;font-size:16px}#board{width:340px;height:340px;background:#bbada0;border-radius:6px;padding:10px;display:grid;grid-template-columns:repeat(4,1fr);grid-gap:10px;box-sizing:border-box;position:relative}.tile{width:70px;height:70px;background:#cdc1b4;border-radius:3px;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:bold;color:#776e65;transition:all 0.1s ease}.t2{background:#eee4da}.t4{background:#ede0c8}.t8{background:#f2b179;color:#f9f6f2}.t16{background:#f59563;color:#f9f6f2}.t32{background:#f67c5f;color:#f9f6f2}.t64{background:#f65e3b;color:#f9f6f2}.t128{background:#edcf72;color:#f9f6f2;font-size:24px}.t256{background:#edcc61;color:#f9f6f2;font-size:24px}.t512{background:#edc850;color:#f9f6f2;font-size:24px}.t1024{background:#edc53f;color:#f9f6f2;font-size:20px}.t2048{background:#edc22e;color:#f9f6f2;font-size:20px}#score-box{background:#bbada0;padding:8px 16px;border-radius:4px;color:#fff;font-weight:bold;margin-bottom:12px;font-size:18px}</style></head><body><h1>2048</h1><p>Use Arrow Keys to join tiles!</p><div id='score-box'>Score: <span id='score'>0</span></div><div id='board'></div><script>let board=Array(4).fill(0).map(()=>Array(4).fill(0));let score=0;function init(){board=Array(4).fill(0).map(()=>Array(4).fill(0));score=0;addTile();addTile();render();}function addTile(){let empty=[];for(let r=0;r<4;r++)for(let c=0;c<4;c++)if(board[r][c]===0)empty.push({r,c});if(empty.length>0){let p=empty[Math.floor(Math.random()*empty.length)];board[p.r][p.c]=Math.random()<0.9?2:4;}}function render(){const el=document.getElementById('board');el.innerHTML='';for(let r=0;r<4;r++){for(let c=0;c<4;c++){let d=document.createElement('div');let val=board[r][c];d.className='tile '+(val?'t'+val:'');d.innerText=val>0?val:'';el.appendChild(d);}}document.getElementById('score').innerText=score;}window.addEventListener('keydown',e=>{let moved=false;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key))e.preventDefault();if(e.key==='ArrowLeft')moved=slideLeft();if(e.key==='ArrowRight')moved=slideRight();if(e.key==='ArrowUp')moved=slideUp();if(e.key==='ArrowDown')moved=slideDown();if(moved){addTile();render();}});function slideLeft(){let moved=false;for(let r=0;r<4;r++){let row=board[r].filter(v=>v!==0);for(let i=0;i<row.length-1;i++){if(row[i]===row[i+1]){row[i]*=2;score+=row[i];row.splice(i+1,1);}}while(row.length<4)row.push(0);if(row.join(',')!==board[r].join(',')){moved=true;board[r]=row;}}return moved;}function slideRight(){let moved=false;for(let r=0;r<4;r++){let row=board[r].filter(v=>v!==0);for(let i=row.length-1;i>0;i--){if(row[i]===row[i-1]){row[i]*=2;score+=row[i];row.splice(i-1,1);i--;}}while(row.length<4)row.unshift(0);if(row.join(',')!==board[r].join(',')){moved=true;board[r]=row;}}return moved;}function rotate(){let n=Array(4).fill(0).map(()=>Array(4).fill(0));for(let r=0;r<4;r++)for(let c=0;c<4;c++)n[c][3-r]=board[r][c];board=n;}function slideUp(){rotate();rotate();rotate();let m=slideLeft();rotate();return m;}function slideDown(){rotate();let m=slideLeft();rotate();rotate();rotate();return m;}init();</script></body></html>"
